      "expected_applicability": ["accessibility", "code", "frontend", "testing", "ui", "ux"],
      "machine_required": ["accessibility", "code", "frontend", "testing", "ui", "ux"],
      "expected_gates": ["FF-BUILD-GATE-DESIGN-DIRECTION", "FF-BUILD-GATE-RUNTIME"],
      "forbidden_defects": [
        "A dashboard is accepted from source inspection without a rendered state matrix.",
        "Mobile overflow or keyboard focus loss is silently treated as a pass.",
        "A generic dashboard is shipped without an intentional design direction."
      ],
      "required_validation_artifacts": [
        "design direction record",
        "hashed screenshots for every planned state and viewport",
        "keyboard and accessibility observations"
