    {
      "id": "secure-file-upload",
      "title": "Secure file upload pipeline",
      "agent_task": "Accept customer evidence files only after authorization, size/type validation, hostile-file rejection, isolated storage naming, and safe downstream processing. Preserve no trust in file name, extension, or client MIME type.",
      "starting_repository": {
        "file_map": [
          { "path": "src/uploads/handler.ts", "content": "export function upload() {}\n" },
          { "path": "src/routes/evidence.ts", "content": "export function evidence() {}\n" }
