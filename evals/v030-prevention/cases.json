{
  "schema_version": 1,
  "cases": [
    {
      "id": "new-saas-app",
      "title": "New multi-user SaaS application",
      "agent_task": "Create a team SaaS app with sign-in, organization-owned projects, a public marketing page, and a deployment workflow. Do not invent a cache or provider integration before a measured need.",
      "starting_repository": {
        "file_map": [
          {
            "path": "src/routes/projects.ts",
            "content": "export function listProjects() { return []; }\n"
          },
          { "path": "app/dashboard/page.tsx", "content": "export const Dashboard = () => null;\n" },
          { "path": ".github/workflows/check.yml", "content": "name: check\n" }
        ]
      },
      "expected_applicability": [
        "api",
        "authorization",
        "code",
        "deployment",
        "frontend",
        "security",
        "tenancy",
        "testing",
        "ui",
        "ux",
        "accessibility"
      ],
      "machine_required": [
        "api",
        "code",
        "deployment",
        "frontend",
        "infrastructure",
        "security",
        "testing",
        "ui",
        "ux",
        "accessibility"
      ],
      "expected_gates": [
        "FF-BUILD-GATE-APPLICABILITY",
        "FF-BUILD-GATE-BEHAVIOR",
        "FF-BUILD-GATE-DESIGN-DIRECTION",
        "FF-BUILD-GATE-RUNTIME",
        "FF-BUILD-GATE-SECURITY-REVIEW"
      ],
      "forbidden_defects": [
        "A project route returns organization data without a server-side ownership predicate.",
        "A generated dashboard is accepted without rendered evidence for every state and viewport.",
        "A cache is introduced merely because the product is called SaaS."
      ],
      "required_validation_artifacts": [
        "organization ownership denial test",
        "rendered dashboard state matrix",
        "deployment configuration review"
      ],
      "checks": [
        { "id": "applicability", "classification": "deterministic", "status": "PASS" },
        { "id": "load-profile", "classification": "nondeterministic", "status": "NOT_VERIFIED" },
        { "id": "ownership-review", "classification": "human-required", "status": "NOT_VERIFIED" },
        {
          "id": "hosted-runtime",
          "classification": "unsupported-external-tool",
          "status": "BLOCKED"
        }
      ]
    },
    {
      "id": "non-slop-dashboard",
      "title": "Intentional non-slop dashboard",
      "agent_task": "Build an operations dashboard for a support lead. It must have an explicit design direction and evidence for loading, empty, error, success, permission-denied, disabled, destructive-confirmation, and long-content states at desktop, tablet, and mobile widths.",
      "starting_repository": {
        "file_map": [
          { "path": "app/dashboard/page.tsx", "content": "export const Dashboard = () => null;\n" }
        ]
