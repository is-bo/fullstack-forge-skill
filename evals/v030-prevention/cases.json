        { "id": "design-review", "classification": "human-required", "status": "NOT_VERIFIED" },
        {
          "id": "browser-capture",
          "classification": "unsupported-external-tool",
          "status": "BLOCKED"
        }
      ]
    },
    {
      "id": "registration-rbac",
      "title": "Registration and role-based access control",
      "agent_task": "Add employee registration and admin-only billing controls. Enforce authentication and object/role authorization at the final server boundary, with denied-path coverage for invalid, expired, replayed, and insufficient-role requests.",
      "starting_repository": {
        "file_map": [
          { "path": "src/auth/register.ts", "content": "export function register() {}\n" },
          { "path": "src/routes/billing.ts", "content": "export function billing() {}\n" },
          { "path": "src/authorization/rbac.ts", "content": "export const role = 'admin';\n" }
        ]
      },
      "expected_applicability": ["api", "auth", "authorization", "code", "security", "testing"],
      "machine_required": ["api", "auth", "authorization", "code", "security", "testing"],
      "expected_gates": [
        "FF-BUILD-GATE-AUTHENTICATION-NEGATIVE",
        "FF-BUILD-GATE-AUTHORIZATION-NEGATIVE",
        "FF-BUILD-GATE-NEGATIVE-SECURITY"
      ],
      "forbidden_defects": [
        "A client role claim bypasses final server-side authorization.",
        "An expired or replayed registration/session token is accepted.",
        "An unauthorized billing request lacks an observed denied path."
      ],
      "required_validation_artifacts": [
        "invalid and expired credential tests",
        "insufficient-role denial test",
        "final-boundary authorization trace"
