      "expected_applicability": ["api", "code", "security", "storage", "testing", "uploads"],
      "machine_required": ["api", "code", "security", "storage", "testing", "uploads"],
      "expected_gates": ["FF-BUILD-GATE-UPLOAD-HOSTILE-FILE", "FF-BUILD-GATE-NEGATIVE-SECURITY"],
      "forbidden_defects": [
        "A hostile file is trusted from its extension or browser MIME value.",
        "An upload is stored under a user-controlled path or served as executable content.",
        "A missing hostile-file test is treated as PASS."
      ],
      "required_validation_artifacts": [
        "polyglot and oversized-file rejection tests",
        "storage authorization trace",
        "malware-processing boundary review"
