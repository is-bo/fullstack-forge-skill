{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fullstack Forge package metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "license",
    "description",
    "entrypoint",
    "moduleCatalog",
    "platforms"
  ],
  "properties": {
    "name": { "const": "fullstack-forge" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "const": "Apache-2.0" },
    "description": { "type": "string", "minLength": 1 },
    "entrypoint": { "const": "src/fullstack-forge/SKILL.md" },
    "moduleCatalog": { "const": "config/modules.json" },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["agents", "claude", "gemini", "cursor", "windsurf", "github"] }
    }
  }
}
