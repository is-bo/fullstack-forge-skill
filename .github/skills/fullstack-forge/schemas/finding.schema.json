{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thethunderbolt/fullstack-forge-skill/schemas/finding.schema.json",
  "title": "Fullstack Forge finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "section",
    "title",
    "severity",
    "confidence",
    "status",
    "location",
    "evidence",
    "impact",
    "recommendation",
    "safe_fix",
    "verification",
    "standards"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FF-[A-Z0-9-]+-[0-9]{3,}$" },
    "instance_id": {
      "type": "string",
      "pattern": "^FF-[A-Z0-9-]+-[0-9]{3,}:[a-f0-9]{8,}$"
    },
    "section": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "status": { "enum": ["PASS", "FAIL", "WARNING", "NOT_APPLICABLE", "NOT_VERIFIED", "BLOCKED"] },
    "location": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "impact": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "safe_fix": { "type": "boolean" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "standards": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "analyzer_id": { "type": "string", "minLength": 1 },
    "fix_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "risk", "reason", "attempted_at"],
        "properties": {
          "fix_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PLANNED", "APPLIED", "BLOCKED", "ROLLED_BACK"] },
          "risk": { "enum": ["safe", "risky", "unsupported"] },
          "reason": { "type": "string", "minLength": 1 },
          "attempted_at": { "type": "string", "format": "date-time" },
          "paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sink", "description"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "sink": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "line": { "type": "integer", "minimum": 1 },
          "excerpt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "analyzer_id", "finding_id", "absence_proves_resolution"],
                "properties": {
                  "type": { "const": "analyzer" },
                  "analyzer_id": { "type": "string", "minLength": 1 },
                  "finding_id": { "type": "string", "minLength": 1 },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^FF-[A-Z0-9-]+-[0-9]{3,}:[a-f0-9]{8,}$"
                  },
                  "scope_paths": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "absence_proves_resolution": { "type": "boolean" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "command", "required"],
                "properties": {
                  "type": { "const": "project-command" },
                  "command": { "type": "string", "minLength": 1 },
                  "required": { "type": "boolean" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "procedure"],
                "properties": {
                  "type": { "const": "manual" },
                  "procedure": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
