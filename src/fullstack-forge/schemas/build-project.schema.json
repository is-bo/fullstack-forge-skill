{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thethunderbolt/fullstack-forge-skill/schemas/build-project.schema.json",
  "title": "Fullstack Forge build project state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "updated_at",
    "product",
    "stack",
    "non_goals",
    "features",
    "frame",
    "design_alignment",
    "selection_events",
    "history"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "product": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary"],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "risk_class": { "enum": ["light", "standard", "high"] },
    "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_statement",
        "target_users",
        "desired_outcomes",
        "business_rules",
        "constraints"
      ],
      "properties": {
        "problem_statement": { "type": "string" },
        "target_users": { "type": "array", "items": { "type": "string" } },
        "desired_outcomes": { "type": "array", "items": { "type": "string" } },
        "business_rules": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "design_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references", "recorded_at"],
      "properties": {
        "status": { "enum": ["NOT_VERIFIED", "ALIGNED", "DRIFT"] },
        "references": { "type": "array", "items": { "type": "string" } },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "applicability_snapshot": { "type": "object" },
    "selection_events": { "type": "array" },
    "history": { "type": "object" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "phase", "tier", "updated_at"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "phase": {
            "enum": ["frame", "plan", "implement", "check", "done", "blocked", "abandoned"]
          },
          "tier": { "enum": ["light", "standard", "high"] },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
