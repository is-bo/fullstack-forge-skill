{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thethunderbolt/fullstack-forge-skill/schemas/build-project.schema.json",
  "title": "Fullstack Forge Build project state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "updated_at",
    "product",
    "stack",
    "non_goals",
    "features",
    "frame",
    "design_alignment",
    "selection_events",
    "history"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "risk_class": { "enum": ["light", "standard", "high"] },
    "stack": { "$ref": "#/$defs/nonEmptyStringArray" },
    "non_goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonGoal" }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureIndex" }
    },
    "frame": { "$ref": "#/$defs/projectFrame" },
    "design_alignment": { "$ref": "#/$defs/designAlignment" },
    "applicability_snapshot": { "$ref": "#/$defs/applicabilitySnapshot" },
    "selection_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectionEvent" }
    },
    "history": { "$ref": "#/$defs/history" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "featureIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "phase", "tier", "updated_at"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "phase": {
          "enum": ["frame", "plan", "implement", "check", "done", "blocked", "abandoned"]
        },
        "tier": { "enum": ["light", "standard", "high"] },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "usersAndRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "roles"],
      "properties": {
        "user": { "type": "string" },
        "roles": { "$ref": "#/$defs/stringArray" }
      }
    },
    "stackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rationale"],
      "properties": {
        "name": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "projectFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_statement",
        "target_users",
        "users_and_roles",
        "desired_outcomes",
        "business_rules",
        "business_invariants",
        "constraints",
        "critical_workflows",
        "sensitive_data_classes",
        "trust_boundaries",
        "expected_scale",
        "stack_entries",
        "assumptions",
        "unresolved_decisions",
        "initial_feature_backlog",
        "design_direction_reference"
      ],
      "properties": {
        "problem_statement": { "type": "string" },
        "target_users": { "$ref": "#/$defs/stringArray" },
        "users_and_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/usersAndRoles" }
        },
        "desired_outcomes": { "$ref": "#/$defs/stringArray" },
        "business_rules": { "$ref": "#/$defs/stringArray" },
        "business_invariants": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "critical_workflows": { "$ref": "#/$defs/stringArray" },
        "sensitive_data_classes": { "$ref": "#/$defs/stringArray" },
        "trust_boundaries": { "$ref": "#/$defs/stringArray" },
        "expected_scale": { "type": "string" },
        "stack_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/stackEntry" }
        },
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "unresolved_decisions": { "$ref": "#/$defs/stringArray" },
        "initial_feature_backlog": { "$ref": "#/$defs/stringArray" },
        "design_direction_reference": { "type": "string" }
      }
    },
    "designAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references", "recorded_at"],
      "properties": {
        "status": { "enum": ["NOT_VERIFIED", "ALIGNED", "DRIFT"] },
        "references": { "$ref": "#/$defs/stringArray" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "applicabilityDiscipline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "applicable", "reason"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "applicable": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "applicabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "disciplines"],
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "source_revision": { "type": "string", "minLength": 1 },
        "disciplines": {
          "type": "array",
          "items": { "$ref": "#/$defs/applicabilityDiscipline" }
        }
      }
    },
    "selectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "action", "value", "reason", "recorded_at", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["discipline", "tier", "applicability"] },
        "action": { "enum": ["selected", "deselected", "recorded"] },
        "value": { "type": "string" },
        "reason": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["user", "cli", "migration"] }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrated_from": { "const": 1 },
        "migrated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
