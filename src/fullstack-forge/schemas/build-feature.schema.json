{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/is-bo/fullstack-forge-skill/schemas/build-feature.schema.json",
  "title": "Fullstack Forge Build feature state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "created_at",
    "updated_at",
    "phase",
    "tier",
    "tier_inputs",
    "summary",
    "disciplines",
    "decisions",
    "assumptions",
    "touched_paths",
    "evidence",
    "risk_acceptances",
    "repair_counters",
    "blockers",
    "evidence_run_ids",
    "selection_events",
    "history"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "phase": {
      "enum": ["frame", "plan", "implement", "check", "done", "blocked", "abandoned"]
    },
    "tier": { "enum": ["light", "standard", "high"] },
    "tier_inputs": { "$ref": "#/$defs/stringArray" },
    "tier_override_reason": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "disciplines": {
      "type": "array",
      "items": { "$ref": "#/$defs/disciplineSelection" }
    },
    "plan_summary": { "type": "string" },
    "plan_hash": { "$ref": "#/$defs/sha256" },
    "decisions": { "$ref": "#/$defs/stringArray" },
    "assumptions": { "$ref": "#/$defs/stringArray" },
    "touched_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterionEvidence" }
    },
    "risk_acceptances": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskAcceptance" }
    },
    "repair_counters": {
      "type": "array",
      "items": { "$ref": "#/$defs/repairCounter" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "evidence_run_ids": { "$ref": "#/$defs/stringArray" },
    "evidence_revision": { "type": "string", "minLength": 1 },
    "applicability_snapshot": { "$ref": "#/$defs/applicabilitySnapshot" },
    "gate_plan": { "$ref": "#/$defs/gatePlan" },
    "selection_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectionEvent" }
    },
    "history": { "$ref": "#/$defs/history" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv",
        "definition",
        "exit_code",
        "started_at",
        "duration_ms",
        "output_sha256",
        "input_manifest"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "argv": { "$ref": "#/$defs/nonEmptyStringArray" },
        "definition": { "type": "string" },
        "exit_code": { "type": "integer" },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "input_manifest": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceArtifact" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "node", "ci"],
      "properties": {
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "node": { "type": "string" },
        "ci": { "type": "boolean" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "role", "state", "viewport"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "viewport": { "$ref": "#/$defs/viewport" }
      }
    },
    "evidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "producer",
        "producer_version",
        "contract",
        "canonical_root",
        "revision",
        "artifacts",
        "criterion",
        "status",
        "run_id",
        "produced_at",
        "expires_at",
        "environment",
        "limitations",
        "instance_ids",
        "claim_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "domain": { "const": "Build" },
        "producer": { "type": "string", "minLength": 1 },
        "producer_version": { "type": "string", "minLength": 1 },
        "contract": { "const": "fullstack-forge.build-evidence/v1" },
        "canonical_root": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceArtifact" }
        },
        "criterion": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_VERIFIED", "NOT_APPLICABLE", "BLOCKED"]
        },
        "run_id": { "type": "string", "minLength": 1 },
        "produced_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "environment": { "$ref": "#/$defs/environment" },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "instance_ids": { "$ref": "#/$defs/stringArray" },
        "evidence_type": { "type": "string" },
        "claim_sha256": { "$ref": "#/$defs/sha256" },
        "command": { "$ref": "#/$defs/evidenceCommand" },
        "runtime": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtime" }
        }
      }
    },
    "criterionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "security_control",
        "status",
        "producer",
        "evidence",
        "files",
        "instance_ids",
        "recorded_at"
      ],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "discipline": { "type": "string", "minLength": 1 },
        "security_control": { "type": "boolean" },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_VERIFIED", "NOT_APPLICABLE", "BLOCKED"]
        },
        "producer": { "type": "string", "minLength": 1 },
        "producer_version": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceFile" }
        },
        "instance_ids": { "$ref": "#/$defs/stringArray" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "revision": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "command": { "$ref": "#/$defs/evidenceCommand" },
        "runtime": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/runtime" }
        },
        "envelope": { "$ref": "#/$defs/evidenceEnvelope" },
        "not_applicable_reason": { "type": "string", "minLength": 1 },
        "migration_state": { "const": "migrated-untrusted" },
        "expired_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "NOT_APPLICABLE" } },
            "required": ["status"]
          },
          "then": { "required": ["not_applicable_reason"] }
        }
      ]
    },
    "riskAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "reason", "revision", "timestamp"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "category": { "enum": ["advisory", "operational"] },
        "actor": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "canonical_root": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["advisory", "operational-human"] },
        "relevant_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceFile" }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "migration_state": { "const": "migrated-untrusted" },
        "lifecycle": { "enum": ["active", "expired"] },
        "expired_at": { "type": "string", "format": "date-time" }
      }
    },
    "repairCounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "signature", "count"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "reason", "timestamp"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "disciplineSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "reason"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "applicabilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discipline", "status", "confidence", "evidence"],
      "properties": {
        "discipline": { "type": "string", "minLength": 1 },
        "status": { "enum": ["REQUIRED", "SUGGESTED", "EXCLUDED", "UNRESOLVED"] },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "exclusion_reason": { "type": "string", "minLength": 1 }
      }
    },
    "applicabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "revision",
        "decisions",
        "required",
        "suggested",
        "unresolved",
        "excluded"
      ],
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "revision": { "type": "string", "minLength": 1 },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/applicabilityDecision" }
        },
        "required": { "$ref": "#/$defs/stringArray" },
        "suggested": { "$ref": "#/$defs/stringArray" },
        "unresolved": { "$ref": "#/$defs/stringArray" },
        "excluded": { "$ref": "#/$defs/stringArray" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tier",
        "criteria",
        "required",
        "waiver_policy",
        "non_waivable",
        "reason"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["light", "standard", "high"] },
        "criteria": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required": { "type": "boolean" },
        "waiver_policy": { "enum": ["never", "advisory", "operational-human"] },
        "non_waivable": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "gatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "revision", "gates", "required_criteria"],
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "revision": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "required_criteria": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "selectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "action", "value", "reason", "recorded_at", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["discipline", "tier", "applicability"] },
        "action": { "enum": ["selected", "deselected", "recorded"] },
        "value": { "type": "string" },
        "reason": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["user", "cli", "migration"] }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrated_from": { "const": 1 },
        "migrated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
