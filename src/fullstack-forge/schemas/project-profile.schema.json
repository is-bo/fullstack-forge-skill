{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thethunderbolt/fullstack-forge-skill/schemas/project-profile.schema.json",
  "title": "Fullstack Forge project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root", "generated_at", "detections", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "root": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "detections": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/detection" }
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
