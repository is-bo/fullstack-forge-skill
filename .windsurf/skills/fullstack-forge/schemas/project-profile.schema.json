{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thethunderbolt/fullstack-forge-skill/schemas/project-profile.schema.json",
  "title": "Fullstack Forge project profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "generated_at",
    "detections",
    "capabilities",
    "repository",
    "workspaces",
    "applications",
    "languages",
    "frameworks",
    "package_managers",
    "databases",
    "orms",
    "authentication",
    "sessions",
    "authorization",
    "roles",
    "tenant_boundaries",
    "routes",
    "storage",
    "upload_pipelines",
    "caches",
    "queues",
    "scheduled_jobs",
    "tests",
    "ci",
    "observability",
    "integrations",
    "ai_providers",
    "payment_providers",
    "hosting",
    "deployment",
    "environment_templates",
    "critical_workflows"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "root": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "detections": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/detection" }
    },
    "capability_assessments": {
      "type": "array",
      "items": { "type": "object" }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "repository": { "$ref": "#/$defs/record" },
    "workspaces": { "$ref": "#/$defs/records" },
    "applications": { "$ref": "#/$defs/records" },
    "languages": { "$ref": "#/$defs/records" },
    "frameworks": { "$ref": "#/$defs/records" },
    "package_managers": { "$ref": "#/$defs/records" },
    "databases": { "$ref": "#/$defs/records" },
    "orms": { "$ref": "#/$defs/records" },
    "authentication": { "$ref": "#/$defs/records" },
    "sessions": { "$ref": "#/$defs/records" },
    "authorization": { "$ref": "#/$defs/records" },
    "roles": { "$ref": "#/$defs/records" },
    "tenant_boundaries": { "$ref": "#/$defs/records" },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "storage": { "$ref": "#/$defs/records" },
    "upload_pipelines": { "$ref": "#/$defs/records" },
    "caches": { "$ref": "#/$defs/records" },
    "queues": { "$ref": "#/$defs/records" },
    "scheduled_jobs": { "$ref": "#/$defs/records" },
    "tests": { "$ref": "#/$defs/records" },
    "ci": { "$ref": "#/$defs/records" },
    "observability": { "$ref": "#/$defs/records" },
    "integrations": { "$ref": "#/$defs/records" },
    "ai_providers": { "$ref": "#/$defs/records" },
    "payment_providers": { "$ref": "#/$defs/records" },
    "hosting": { "$ref": "#/$defs/records" },
    "deployment": { "$ref": "#/$defs/records" },
    "environment_templates": { "$ref": "#/$defs/records" },
    "critical_workflows": { "$ref": "#/$defs/records" }
  },
  "$defs": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "candidate_files_discovered",
        "files_inspected",
        "files_skipped",
        "bytes_considered",
        "bytes_read",
        "binary_probe_bytes",
        "binary_files_skipped",
        "ignored_paths_excluded",
        "generated_paths_excluded",
        "default_paths_excluded",
        "user_paths_excluded",
        "required_evidence_excluded",
        "per_file_limit_bytes",
        "inspection_budget_bytes",
        "max_inventory_entries",
        "max_directory_depth",
        "forgeignore_patterns",
        "cli_exclusions",
        "excluded_paths",
        "largest_inspected_files",
        "largest_contributing_directories",
        "affected_modules",
        "suggested_actions"
      ],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL"] },
        "reason": { "type": "string" },
        "source": { "enum": ["git", "fallback"] },
        "git_root": { "type": "string" },
        "git_failure": { "type": "string" },
        "candidate_files_discovered": { "type": "integer", "minimum": 0 },
        "files_inspected": { "type": "integer", "minimum": 0 },
        "files_skipped": { "type": "integer", "minimum": 0 },
        "bytes_considered": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "binary_probe_bytes": { "type": "integer", "minimum": 0 },
        "binary_files_skipped": { "type": "integer", "minimum": 0 },
        "ignored_paths_excluded": { "type": "integer", "minimum": 0 },
        "generated_paths_excluded": { "type": "integer", "minimum": 0 },
        "default_paths_excluded": { "type": "integer", "minimum": 0 },
        "user_paths_excluded": { "type": "integer", "minimum": 0 },
        "required_evidence_excluded": { "type": "boolean" },
        "per_file_limit_bytes": { "type": "integer", "minimum": 1 },
        "inspection_budget_bytes": { "type": "integer", "minimum": 1 },
        "max_inventory_entries": { "type": "integer", "minimum": 1 },
        "max_directory_depth": { "type": "integer", "minimum": 1 },
        "forgeignore_patterns": { "type": "array", "items": { "type": "string" } },
        "cli_exclusions": { "type": "array", "items": { "type": "string" } },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "category"],
            "properties": {
              "path": { "type": "string" },
              "category": { "type": "string" },
              "pattern": { "type": "string" }
            }
          }
        },
        "largest_inspected_files": { "$ref": "#/$defs/contributors" },
        "largest_contributing_directories": { "$ref": "#/$defs/contributors" },
        "affected_modules": { "type": "array", "items": { "type": "string" } },
        "suggested_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "confidence", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "confidence", "evidence", "visibility"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "visibility": {
          "enum": ["public", "authenticated", "admin", "internal", "unknown"]
        }
      }
    }
  }
}
